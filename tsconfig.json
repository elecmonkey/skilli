{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "rstack.config.ts",
    "packages/*/rstack.config.ts",
    "packages/*/tests/**/*.ts"
  ]
}
